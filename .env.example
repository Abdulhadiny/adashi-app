# ─────────────────────────────────────────────────────────────────────────────
# Adashi environment template.
#
# Copy this file to BOTH of the following (both are gitignored):
#   • .env        — read by drizzle-kit for migrations/seed (via dotenv/config)
#   • .env.local  — read by the Next.js runtime
#
#   cp .env.example .env
#   cp .env.example .env.local
#
# At minimum, set DATABASE_URL and AUTH_SECRET.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string.
# Local Docker (docker-compose.yml) publishes Postgres on host port 5433 to avoid
# colliding with a native install on 5432. Required by both .env and .env.local.
DATABASE_URL=postgres://adashi:adashi@localhost:5433/adashi

# Auth.js secret — signs JWT sessions AND keys the HMAC used to hash OTP codes.
# Generate one with:  npx auth secret
# Required by .env.local (the runtime); harmless to include in .env too.
AUTH_SECRET=replace-me-with-a-strong-random-secret

# Trust the incoming Host header (needed on localhost and non-Vercel hosts).
# Required by .env.local.
AUTH_TRUST_HOST=true

# ── SMS / OTP provider (optional) ────────────────────────────────────────────
# Leave unset in development: login OTP codes are logged to the server console by
# the dev stub. Wire a real provider for production behind the SmsProvider seam in
# lib/auth/otp.ts. (In-app notifications replaced outbound WhatsApp/SMS messaging.)
# SMS_PROVIDER=console              # console (default) | termii | twilio
# TERMII_API_KEY=
# TERMII_SENDER_ID=Adashi
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
